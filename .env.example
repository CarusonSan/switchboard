# Discord bot token (Discord Developer Portal -> Bot -> Token)
DISCORD_TOKEN=

# Application ID (Discord Developer Portal -> General Information)
DISCORD_CLIENT_ID=

# Optional: register commands to a single guild for instant updates during development.
# Leave unset to register commands globally.
DISCORD_GUILD_ID=

# Optional: public hostname or IP of the VPS, shown to players in connect info.
PUBLIC_HOST=

# Optional: path to the Docker socket (default: /var/run/docker.sock)
# DOCKER_SOCKET=/var/run/docker.sock

# Warm pool: comma-separated <game>=<count> pairs. These servers are kept booted
# and handed over instantly on /server create. Each holds its full RAM footprint
# (a Minecraft server is ~2GB), so size this to your VPS.
# WARM_POOL=minecraft=1

# Auto-stop servers whose CPU stays below IDLE_CPU_PERCENT for IDLE_MINUTES
# consecutive minutes (a proxy for "no players online"). Set IDLE_MINUTES=0 to disable.
IDLE_MINUTES=30
IDLE_CPU_PERCENT=5
